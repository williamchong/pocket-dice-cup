# The App Store listing is kept here as text so a change to it is reviewed
# and kept in git like the code. The listing goes up with an App Store
# Connect API key, either a .json file (key_id, issuer_id, key) named by
# APP_STORE_CONNECT_API_KEY_PATH, or the .p8 Apple hands out, named by
# APP_STORE_CONNECT_API_KEY_KEY_FILEPATH with APP_STORE_CONNECT_API_KEY_KEY_ID
# and APP_STORE_CONNECT_API_KEY_ISSUER_ID. Either stays out of git.

default_platform(:ios)

platform :ios do
  desc "Send the name, description, keywords, URLs, categories, age rating and review notes to App Store Connect"
  lane :metadata do
    # With no .json key, the action reads the .p8 and its two IDs from the
    # environment and hands the key on to deliver.
    app_store_connect_api_key unless ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    deliver(
      metadata_path: "fastlane/metadata",
      app_rating_config_path: "fastlane/age_rating.json",
      skip_binary_upload: true,
      # Made by `node fastlane/screenshots.mjs`; each upload replaces the last.
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: false,
      # The listing is checked by reading the diff, not by an HTML preview.
      force: true,
      run_precheck_before_submit: false
    )
  end

  # fastlane's App Privacy action cannot use an API key: it logs in with the
  # Apple ID in FASTLANE_USER, with its two-factor prompt, instead.
  desc "Send the App Privacy answers, the same data the privacy manifest and PRIVACY.md list"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      json_path: "fastlane/app_privacy_details.json"
    )
  end
end
